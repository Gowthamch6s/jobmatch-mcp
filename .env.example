# Adzuna API credentials (https://developer.adzuna.com/)
# Server-side only -- never passed through model context or tool arguments.
# If unset, the server runs in MOCK mode: search_jobs returns deterministic
# sample listings so the server is still fully runnable and testable.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Where the local SQLite application-tracking database lives.
JOBMATCH_DB_PATH=./jobmatch.db

# Log level for structured call logs (DEBUG, INFO, WARNING, ERROR)
JOBMATCH_LOG_LEVEL=INFO
